VITE_API_URL=http://localhost:5000/api
VITE_ADMIN_URL=http://localhost:5174
# Public consumer site URL (used for SEO, canonical links, and Search Console)
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Local business app. Production example: https://business.yourdomain.com
VITE_BUSINESS_URL=http://localhost:5175

# Google Sign-In — OAuth 2.0 Web client ID from Google Cloud Console
# Must match backend GOOGLE_CLIENT_ID. Authorized JavaScript origins:
#   http://localhost:5173 (and your production frontend URL)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
